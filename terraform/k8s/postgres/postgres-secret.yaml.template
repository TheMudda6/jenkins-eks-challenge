# -----------------------------------------------------------------------------
# PostgreSQL Secret
#
# Purpose:
# Stores the PostgreSQL credentials used by the PostgreSQL StatefulSet.
#
# This file intentionally contains placeholder values. Replace them before
# deployment or generate the file during deployment for production use.
# -----------------------------------------------------------------------------

apiVersion: v1
kind: Secret

metadata:
  name: postgres-secret
  namespace: jenkins

type: Opaque

stringData:

  # ---------------------------------------------------------------------------
  # Database Configuration
  # ---------------------------------------------------------------------------

  POSTGRES_DB: ${POSTGRES_DB}

  POSTGRES_USER: ${POSTGRES_USER}

  POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}