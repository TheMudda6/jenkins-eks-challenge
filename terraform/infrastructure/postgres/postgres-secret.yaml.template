# -----------------------------------------------------------------------------
# PostgreSQL Secret Template
#
# Purpose:
# Defines the structure of the Kubernetes Secret used by PostgreSQL.
#
# This file is a template only and does not contain real credentials.
# Runtime credentials are supplied through the project's external secret
# management configuration.
# -----------------------------------------------------------------------------

apiVersion: v1
kind: Secret

metadata:
  name: postgres-secret
  namespace: jenkins

type: Opaque

stringData:
  POSTGRES_DB: ${POSTGRES_DB}
  POSTGRES_USER: ${POSTGRES_USER}
  POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}